#!/usr/bin/env bash
#MISE description="Build, ship and deploy marending (run acta deploy first for acta-net)"
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$root"
# shellcheck source=/dev/null
source "$root/mise-tasks/lib/env.sh"
load_deploy_env

host="${ACTA_HOST:-eos}"
tag="$(date +%Y%m%d-%H%M%S)-$(git rev-parse --short HEAD 2>/dev/null || echo nogit)"
image="localhost/marending:${tag}"

command -v podman >/dev/null || die "podman not found"
command -v zstd >/dev/null || die "zstd not found"
podman info >/dev/null 2>&1 || die "podman machine is not running"

# Acta's sensor secrets are optional here. Without them the container still
# starts, the exporter logs that it is disabled, and the site keeps serving.
if ssh "$host" 'podman secret exists acta-auth-sensor-user' >/dev/null 2>&1 &&
    ssh "$host" 'podman secret exists acta-auth-sensor-password' >/dev/null 2>&1; then
    sensor_auth=on
else
    sensor_auth=off
    note "Acta sensor secrets are missing; event reporting will be disabled"
fi

# acta-net is declared by the acta checkout, whose deploy installs the network
# unit. Check for that file instead of creating a second copy here.
ssh "$host" 'test -f "$HOME/.config/containers/systemd/acta-net.network"' ||
    die "acta-net.network is not installed; run 'mise run deploy' in the acta checkout first"

note "building ${image}"
podman build -t "$image" -t localhost/marending:current .

note "shipping ${image} to ${host}"
podman save "$image" | zstd -q -T0 | ssh "$host" 'zstd -q -d | podman load'
ssh "$host" "podman tag ${image} localhost/marending:current"

# Every non-secret setting the service understands, with the value this deploy
# should use. A variable set in .deploy.env (or the environment) wins over the
# default here. Non-secret configuration is rendered straight into the quadlet,
# so the unit is the single source of truth and there is no env file to keep in
# sync. Credentials are podman secrets and never pass through this task.
tunables=(
    "TZ=UTC"
    "SERVE_PORT=3000"
    "ACTA_URL=http://acta:8080"
    "ACTA_SOURCE=marending"
    "ACTA_FLUSH_MS=1000"
    "ACTA_MAX_BATCH=1000"
    "ACTA_MAX_BYTES=1048576"
    "ACTA_QUEUE_CAPACITY=65536"
    "ACTA_REQUEST_TIMEOUT_MS=5000"
    "ACTA_SHUTDOWN_TIMEOUT_MS=10000"
)

config=""
for entry in "${tunables[@]}"; do
    name="${entry%%=*}"
    value="${!name-}"
    [[ -n "$value" ]] || value="${entry#*=}"
    config+="Environment=${name}=${value}"$'\n'
done
config="${config%$'\n'}"

note "installing marending.container (${tag})"
sed_args=(-e "s|__TAG__|${tag}|g")
# Drop the secret lines when the secrets are not installed; a quadlet that names
# a missing secret would otherwise refuse to start.
[[ "$sensor_auth" == on ]] || sed_args+=(-e '/type=env,target=ACTA_INGEST_/d')
sed "${sed_args[@]}" marending.container |
    CONFIG="$config" awk '{ if ($0 == "__CONFIG__") print ENVIRON["CONFIG"]; else print }' |
    ssh "$host" 'mkdir -p "$HOME/.config/containers/systemd" && cat > "$HOME/.config/containers/systemd/marending.container"'

note "restarting"
ssh "$host" 'systemctl --user daemon-reload && systemctl --user restart marending'

# A container that dies while starting leaves the unit inactive after a clean
# exit, so nothing fails loudly. Check before reporting success.
if ! ssh "$host" 'podman ps --format "{{.Names}}" | grep -qx systemd-marending'; then
    ssh "$host" 'systemctl --user status marending --no-pager -n 20; echo; podman logs --tail 40 systemd-marending 2>&1' >&2 || true
    die "marending did not stay running after the restart"
fi

note "health check"
if ssh "$host" 'curl -sf --max-time 15 -o /dev/null http://127.0.0.1:3004/'; then
    echo "ok"
else
    echo "WARN: / is not reachable on 127.0.0.1:3004"
    ssh "$host" 'curl -s --max-time 15 -o /dev/null -w "%{http_code}\n" http://127.0.0.1:3004/' || true
    echo "logs: ssh ${host} journalctl --user -u marending -n 50"
fi

note "pruning old images (keeping 5)"
ssh "$host" 'podman images --format "{{.Repository}}:{{.Tag}}" \
    | grep -E "^localhost/marending:" | grep -v ":current$" | sort \
    | head -n -5 | xargs -r podman rmi >/dev/null 2>&1 || true'

note "deployed ${image}"
