# Non-secret deploy configuration, committed and read by every
# `mise run deploy*` task. Uncomment a line to override the default shown in
# brackets. Everything set here is rendered into the systemd unit as an
# Environment= line, so `systemctl --user cat marending` always shows the
# effective configuration.
#
# Credentials never belong here. marending reuses Acta's podman secrets
# acta-auth-sensor-user / acta-auth-sensor-password; there is no second copy of
# the sensor credential in this repository.

# --- deploy target ----------------------------------------------------------
# ssh host alias of the server [eos]
ACTA_HOST=eos

# --- runtime ----------------------------------------------------------------
SERVE_PORT=3000
# Acta is reached by name over the shared acta-net. Caddy reaches this service
# at 127.0.0.1:3004, which the quadlet publishes (host 3004 -> container 3000).
ACTA_URL=http://acta:8080
ACTA_SOURCE=marending

# The exporter's limits. These are the values the wide-event client starts with;
# see service/src/wide/sink.rs.
# ACTA_FLUSH_MS=1000
# ACTA_MAX_BATCH=1000
# ACTA_MAX_BYTES=1048576
# ACTA_QUEUE_CAPACITY=65536
# ACTA_REQUEST_TIMEOUT_MS=5000
# ACTA_SHUTDOWN_TIMEOUT_MS=10000
