---
import Chart from 'src/components/Chart.astro';
import { Figure } from 'src/components/Figure';
import * as Plot from '@observablehq/plot';

let results = [
	{ arch: 'M1', threads: 1, data: 100000 },
	{ arch: 'M1', threads: 2, data: 199000 },
	{ arch: 'M1', threads: 4, data: 400000 },
	{ arch: 'M1', threads: 8, data: 480000 },
	{ arch: 'CAX21', threads: 1, data: 33000 },
	{ arch: 'CAX21', threads: 2, data: 66000 },
	{ arch: 'CAX21', threads: 4, data: 129000 },
	{ arch: 'CAX21', threads: 8, data: 129000 },
];
---

<Figure caption="Figure 1. sysbench CPU benchmark results">
	<Chart
		options={{
			x: { grid: true, label: '→ events' },
			y: { inset: 2, label: null },
			marks: [
				Plot.frame(),
				Plot.barX(results, {
					x: 'data',
					y: 'arch',
					fy: 'threads',
				}),
				Plot.text(results, {
					text: (d) => `${Math.floor(d.data / 1000)} K`,
					y: 'arch',
					x: 'data',
					textAnchor: 'end',
					dx: -3,
					fill: 'white',
					fy: 'threads',
				}),
			],
		}}
	/>
</Figure>
