---
import Chart from 'src/components/Chart.astro';
import { Figure } from 'src/components/Figure';
import * as Plot from '@observablehq/plot';

let results = [
	{ arch: 'M1', threads: 1, data: 7580 },
	{ arch: 'M1', threads: 2, data: 12811 },
	{ arch: 'M1', threads: 4, data: 21124 },
	{ arch: 'M1', threads: 8, data: 7433 },
	{ arch: 'CAX21', threads: 1, data: 4244 },
	{ arch: 'CAX21', threads: 2, data: 3484 },
	{ arch: 'CAX21', threads: 4, data: 5755 },
	{ arch: 'CAX21', threads: 8, data: 5404 },
];
---

<Figure caption="Figure 2. sysbench memory benchmark results">
	<Chart
		options={{
			x: { grid: true, label: '→ MiB/s' },
			y: { inset: 2, label: null },
			marks: [
				Plot.frame(),
				Plot.barX(results, {
					x: 'data',
					y: 'arch',
					fy: 'threads',
				}),
				Plot.text(results, {
					text: (d) => `${d.data}`,
					y: 'arch',
					x: 'data',
					textAnchor: 'end',
					dx: -3,
					fill: 'white',
					fy: 'threads',
				}),
			],
		}}
	/>
</Figure>
